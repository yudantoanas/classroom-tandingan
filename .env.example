# ==========================================
# GitHub Classroom Alternative Config (.env)
# ==========================================

# Target GitHub Organization name
# ORG="octo-academy"
ORG=

# Batch / Cohort / Class identifier (e.g., "cohort-2026", "class-alpha")
# BATCH_NAME="cohort-2026"
BATCH_NAME=

# Target Team Name inside organization (used for invitations)
# TEAM_NAME="students-group-a"
TEAM_NAME=

# Array of student GitHub usernames
# Separate with spaces/newlines
# USERS=(
#     "studentOne"
#     "studentTwo"
#     "studentThree"
# )
USERS=()

# Reviewers / Instructors / TAs (Format: ("user1" "user2"))
# REVIEWERS=(
#     "instructorLead"
#     "teachingAssistantA"
# )
REVIEWERS=()

# Template repositories and optional deadlines
# Format: "organization/templateRepo|YYYY-MM-DD HH:MM"
# TEMPLATES=(
#     "octo-academy/assignment-1|2026-12-31 23:59"
#     "octo-academy/assignment-2|2026-12-31 23:59"
# )
TEMPLATES=()
